{
  "name": "world-of-claudecraft-addons",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Addon loader and official marketplace for World of ClaudeCraft",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarshalX/world-of-claudecraft-addons.git"
  },
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node loader/build-runtime.mjs && node tools/dev.mjs",
    "serve": "node tools/serve.mjs",
    "build": "node loader/build-runtime.mjs && vite build",
    "site": "node tools/site.mjs",
    "site:dev": "node tools/site-dev.mjs",
    "build:runtime": "node loader/build-runtime.mjs",
    "build:runtime:debug": "node loader/build-runtime.mjs --sourcemap",
    "check": "pnpm run check:ts && pnpm run lint && pnpm run test && pnpm run validate",
    "check:ts": "tsc --noEmit",
    "lint": "node tools/lint.mjs",
    "fix": "biome check --write --error-on-warnings .",
    "test": "vitest run",
    "validate": "node tools/validate.mjs",
    "index": "node tools/index.mjs",
    "cues": "node tools/cues.mjs",
    "icons": "node tools/icons.mjs",
    "changelog": "git-cliff --config cliff.toml --output CHANGELOG.md"
  },
  "dependencies": {
    "comlink": "^4.4.2",
    "interactjs": "^1.10.27",
    "preact": "^10.29.7",
    "semver": "^7.8.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.2",
    "@types/semver": "^7.7.1",
    "@types/tampermonkey": "^5.0.5",
    "esbuild": "^0.28.1",
    "git-cliff": "2.13.1",
    "happy-dom": "^20.11.1",
    "markdown-it": "^14.3.0",
    "sharp": "^0.35.3",
    "shiki": "^4.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-monkey": "^8.1.0",
    "vitest": "^4.1.10"
  }
}
