.DS_Store

node_modules/
*.log

# Never committed, on a tag or otherwise. The built userscript is published as a
# GitHub Release asset, which is immutable and addressable, rather than as a file
# in the tree that a branch pointer could change under an installed player.
loader/dist/

# Generated by tools/site.mjs.
site/dist/

# Generated by loader/build-stage.mjs. The stage is a local tool, so its bundle
# is built on demand and never committed; stage/theme.generated.css IS committed,
# because it is a reading of the deployed game that `pnpm theme` takes by hand.
stage/stage.js
