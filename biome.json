{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "origin/main"
  },
  "files": {
    "includes": ["**", "!**/node_modules", "!loader/dist", "!marketplace.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "all",
      "correctness": {
        "useQwikValidLexicalScope": "off"
      },
      "style": {
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["vite.config.ts", "vitest.config.ts", "loader/src/raw.d.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["loader/src/host/**"],
      "javascript": {
        "globals": [
          "GM",
          "GM_addValueChangeListener",
          "GM_deleteValue",
          "GM_getValue",
          "GM_info",
          "GM_listValues",
          "GM_registerMenuCommand",
          "GM_removeValueChangeListener",
          "GM_setValue",
          "GM_xmlhttpRequest"
        ]
      }
    },
    {
      "includes": ["**/*.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noReactSpecificProps": "off"
          },
          "correctness": {
            "noSolidDestructuredProps": "off"
          },
          "performance": {
            "noJsxPropsBind": "off",
            "useSolidForComponent": "off"
          }
        }
      }
    },
    {
      "includes": [
        "tools/**",
        "loader/build-runtime.mjs",
        "loader/build-stage.mjs",
        "addons/*/generate.mjs"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          },
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["addons/**"],
      "javascript": {
        "globals": ["woc"]
      },
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    },
    {
      "includes": ["tests/**", "addons/*/*.test.ts", "addons/*/stage.ts"],
      "linter": {
        "rules": {
          "style": {
            "noMagicNumbers": "off",
            "noExcessiveLinesPerFile": "off"
          },
          "security": {
            "noSecrets": "off"
          },
          "performance": {
            "useTopLevelRegex": "off"
          },
          "suspicious": {
            "noMisplacedAssertion": "off"
          },
          "complexity": {
            "noExcessiveLinesPerFunction": {
              "level": "error",
              "options": {
                "maxLines": 200
              }
            }
          }
        }
      }
    },
    {
      "includes": ["site/content/examples/**"],
      "javascript": {
        "globals": ["woc"]
      }
    },
    {
      "includes": ["**/*.generated.d.ts"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.generated.css"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off",
            "noHexColors": "off"
          }
        }
      }
    }
  ]
}
