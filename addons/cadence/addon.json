{
  "id": "cadence",
  "name": "Cadence",
  "version": "1.1.0",
  "apiVersion": 1,
  "apiMinor": 4,
  "author": "MarshalX",
  "description": "The four timings a rotation is played against, on one thin strip: your swing, the global cooldown, your cast with a latency band, and your resource with combo points as pips.",
  "entry": "main.js",
  "preview": {
    "file": "preview.png",
    "alt": "On the left, Casting, four thin bars on a bare strip: swing, global cooldown, cast, resource. On the right, Combo points, the same four on a rogue, over a row of combo pips."
  },
  "homepage": "https://github.com/MarshalX/world-of-claudecraft-addons",
  "tags": ["combat", "interface"],
  "permissions": ["world.read", "net.read", "ui", "keys"],
  "keybinds": [
    {
      "id": "toggle",
      "label": "Show or hide the strip",
      "default": "Alt+KeyG"
    }
  ],
  "settings": [
    {
      "id": "show-swing",
      "type": "boolean",
      "label": "Show the swing timer",
      "default": true
    },
    {
      "id": "show-gcd",
      "type": "boolean",
      "label": "Show the global cooldown",
      "default": true
    },
    {
      "id": "show-cast",
      "type": "boolean",
      "label": "Show the cast bar",
      "default": true
    },
    {
      "id": "show-power",
      "type": "boolean",
      "label": "Show your resource and combo points",
      "default": true
    },
    {
      "id": "bar-height",
      "type": "number",
      "label": "Row height in pixels",
      "default": 14,
      "min": 8,
      "max": 32
    },
    {
      "id": "show-latency",
      "type": "boolean",
      "label": "Draw the latency band on the cast bar",
      "default": true
    },
    {
      "id": "hide-out-of-combat",
      "type": "boolean",
      "label": "Hide the strip while you are not fighting",
      "default": false
    }
  ]
}
