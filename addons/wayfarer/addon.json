{
  "id": "wayfarer",
  "name": "Wayfarer",
  "version": "1.2.0",
  "apiVersion": 1,
  "apiMinor": 6,
  "author": "MarshalX",
  "description": "An atlas: where everything is, how far, and which way. Every row carries an arrow pointing the way you would have to turn to walk there, so the list is read by turning until one of them points up.",
  "entry": "main.js",
  "preview": {
    "file": "preview.png",
    "alt": "two named pins standing over the world on thin pillars, each with its distance beside it, and a panel under them naming the zone and listing the nearest places in it."
  },
  "data": ["atlas.json"],
  "homepage": "https://github.com/MarshalX/world-of-claudecraft-addons",
  "tags": ["world", "progression", "interface"],
  "permissions": ["world.read", "ui", "keys"],
  "keybinds": [
    {
      "id": "toggle",
      "label": "Show or hide the atlas",
      "default": "Alt+KeyW"
    }
  ],
  "settings": [
    {
      "id": "show-points",
      "type": "boolean",
      "label": "List points of interest",
      "default": true
    },
    {
      "id": "show-towns",
      "type": "boolean",
      "label": "List town hubs",
      "default": true
    },
    {
      "id": "show-graveyards",
      "type": "boolean",
      "label": "List graveyards",
      "default": true
    },
    {
      "id": "show-portals",
      "type": "boolean",
      "label": "List portals",
      "default": true
    },
    {
      "id": "show-mailboxes",
      "type": "boolean",
      "label": "List mailboxes",
      "default": true
    },
    {
      "id": "show-stations",
      "type": "boolean",
      "label": "List crafting stations",
      "default": true
    },
    {
      "id": "draw-distance",
      "type": "number",
      "label": "How far out to look, in yards",
      "default": 300,
      "min": 40,
      "max": 1200
    },
    {
      "id": "list-length",
      "type": "number",
      "label": "How many rows the list holds",
      "default": 8,
      "min": 1,
      "max": 20
    },
    {
      "id": "show-visited",
      "type": "boolean",
      "label": "Show how much of this zone you have explored",
      "default": true
    }
  ]
}
