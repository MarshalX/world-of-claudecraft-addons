{
  "id": "dev-harness",
  "name": "Dev Harness",
  "version": "1.1.0",
  "apiVersion": 1,
  "apiMinor": 1,
  "author": "MarshalX",
  "description": "Exercises every part of the addon API and reports what worked, repainting as the world moves, so a loader change can be checked in the game rather than only in a test.",
  "entry": "main.js",
  "homepage": "https://github.com/MarshalX/world-of-claudecraft-addons",
  "tags": ["development"],
  "permissions": ["net.read", "world.read", "ui", "sound", "keys", "storage"],
  "keybinds": [
    {
      "id": "toggle",
      "label": "Toggle the harness window",
      "default": "Alt+KeyH"
    },
    {
      "id": "run",
      "label": "Run the checks again",
      "default": "Alt+Shift+KeyH"
    }
  ],
  "settings": [
    {
      "id": "cue",
      "type": "string",
      "label": "Cue played by the sound check",
      "default": "ui_click"
    },
    {
      "id": "open-on-load",
      "type": "boolean",
      "label": "Open the window when the addon loads",
      "default": true
    },
    {
      "id": "net-samples",
      "type": "number",
      "label": "Frames to count before the net check passes",
      "default": 5,
      "min": 1,
      "max": 100
    },
    {
      "id": "detail",
      "type": "select",
      "label": "How much each check reports",
      "default": "everything",
      "options": ["failures", "everything"]
    }
  ]
}
