{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    // tampermonkey declares the GM_* and GM globals. They land ambient
    // project-wide, so loader/build-runtime.mjs enforces at build time that no
    // host module reaches the page-realm bundle.
    "types": ["vitest/globals", "tampermonkey"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "exactOptionalPropertyTypes": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    // Relative imports carry an explicit .ts extension so the same source runs
    // under Node's type stripping, which tools/*.mjs relies on, as well as under
    // esbuild and vitest.
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "noEmit": true
  },
  "include": ["loader/src", "packages", "tools", "tests"],
  "exclude": ["node_modules", "loader/dist", "addons"]
}
