{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    // The manager UI is preact. The automatic runtime keeps component files free
    // of a factory import, and jsxImportSource aims the generated import at
    // preact, since react is not a dependency here. Kept in step with the same
    // two settings in vitest.config.ts and loader/build-runtime.mjs.
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    // tampermonkey declares the GM_* and GM globals. They land ambient
    // project-wide, so loader/build-runtime.mjs enforces at build time that no
    // host module reaches the page-realm bundle.
    // `node` is here for tools/*.ts only. Those run under Node's built-in type
    // stripping so the manifest schema has one definition across CI, the dev
    // server, and the loader; typing them means the node builtins have to
    // resolve. loader/build-runtime.mjs is what keeps a node import out of the
    // page-realm bundle, since ambient types cannot.
    "types": ["vitest/globals", "tampermonkey", "node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "exactOptionalPropertyTypes": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    // Relative imports carry an explicit .ts extension so the same source runs
    // under Node's type stripping, which tools/*.mjs relies on, as well as under
    // esbuild and vitest.
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "noEmit": true
  },
  // An addon's own suite sits beside its source, so `addons` is included for its
  // `.test.ts` files ALONE. The addon itself is plain JavaScript evaluated as a
  // function body, and `allowJs` is off, so a `main.js` is never compiled here
  // even though its directory is listed: the glob is what says so out loud.
  "include": ["loader/src", "packages", "tools", "tests", "addons/**/*.test.ts"],
  "exclude": ["node_modules", "loader/dist"]
}
