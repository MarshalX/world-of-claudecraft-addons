{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    // Preact's automatic runtime. Keep in step with vitest.config.ts and
    // loader/build-runtime.mjs.
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    // `tampermonkey` (for the host) and `node` (for tools/*.ts) are ambient
    // project-wide, so the compiler cannot keep them out of the page realm;
    // loader/build-runtime.mjs fails the build if either reaches the runtime bundle.
    "types": ["vitest/globals", "tampermonkey", "node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "exactOptionalPropertyTypes": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    // Explicit .ts extensions let the same source run under Node's type stripping.
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "noEmit": true
  },
  // An addon's suite and stage scenario are listed explicitly: both are reached
  // only through generated entries, so a file left out here is never typechecked.
  // `main.js` is plain JS and `allowJs` is off.
  "include": [
    "loader/src",
    "packages",
    "tools",
    "tests",
    "stage/src",
    "addons/**/*.test.ts",
    "addons/*/stage.ts"
  ],
  "exclude": ["node_modules", "loader/dist"]
}
